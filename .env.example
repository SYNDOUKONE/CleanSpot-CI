# Copier ce fichier en .env et adapter les valeurs.
# Toutes les variables sont préfixées CLEANSPOT_.

# SQLite par défaut ; PostgreSQL/PostGIS en production :
# CLEANSPOT_DATABASE_URL=postgresql+psycopg2://cleanspot:cleanspot@localhost:5432/cleanspot
CLEANSPOT_DATABASE_URL=sqlite:///cleanspot.db

# Poids entraînés (absents => détecteur de démonstration MockDetector)
CLEANSPOT_DETECTION_WEIGHTS=models/detection/best.pt
CLEANSPOT_SEGMENTATION_WEIGHTS=models/segmentation/best-seg.pt

# Stockage des images : local par défaut, MinIO/S3 si configuré
CLEANSPOT_MEDIA_DIR=backend/media
# CLEANSPOT_S3_ENDPOINT=http://localhost:9000
# CLEANSPOT_S3_BUCKET=cleanspot-media
# CLEANSPOT_S3_ACCESS_KEY=cleanspot
# CLEANSPOT_S3_SECRET_KEY=changeme

# Paramètres cartographie
CLEANSPOT_SESSION_MERGE_SECONDS=180
CLEANSPOT_SESSION_MERGE_RADIUS_M=30
CLEANSPOT_HOTSPOT_EPS_M=75
CLEANSPOT_HOTSPOT_MIN_SAMPLES=3
